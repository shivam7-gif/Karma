# ==============================================================================
# Karma Environment Configuration Example
# Copy this file to backend/.env and customize with your own credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend & MCP Network Configuration
# ------------------------------------------------------------------------------
MCP_PORT=3000
API_PORT=4000
MCP_URL=http://localhost:3000/mcp

# ------------------------------------------------------------------------------
# Model Provider Credentials (AWS Bedrock / LangChain)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# Optional model overrides:
# AWS_BEDROCK_CHAT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# Set to 'false' to connect frontend to the live backend API server
VITE_USE_MOCK=true
VITE_API_ENDPOINT=https://karma-api.onrender.com/api/chat

# ------------------------------------------------------------------------------
# OAuth 2.0 Credentials (Google & GitHub)
# ------------------------------------------------------------------------------
# Google Cloud Console: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth Apps: https://github.com/settings/developers
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Live Frontend URL for CORS / Callbacks
FRONTEND_URL=https://karma-1lkx.onrender.com
NODE_ENV=production
PORT=10000
