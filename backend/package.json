{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:api": "tsx watch --env-file=.env src/index.ts",
    "dev:mcp": "tsx watch --env-file=.env src/mcp/server.ts",
    "inspector": "npx @modelcontextprotocol/inspector",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:api": "node --env-file=.env dist/index.js",
    "start:mcp": "node --env-file=.env dist/mcp/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest --no-file-parallelism",
    "overlay": "electron src/overlay/electron-main.cjs",
    "test:amazon": "tsx --env-file=.env test/test-amazon.ts"
  },
  "dependencies": {
    "@langchain/aws": "1.4.6",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.5.0",
    "@langchain/mcp-adapters": "2.0.1",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/cors": "^2.8.19",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "playwright": "^1.64.1",
    "postgres": "^3.4.9",
    "typescript": "^5.7.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pdf-parse": "^1.1.5",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
