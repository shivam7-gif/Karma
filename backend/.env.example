# ==============================================================================
# Karma Backend Environment Configuration
# Copy this file to backend/.env and fill in your own credentials.
# NEVER commit backend/.env — it is already in .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (Neon Postgres — required)
# Get from: Neon Console → Project → Connect
#   DATABASE_URL        → "Pooled connection" (contains -pooler in host)
#   DATABASE_URL_UNPOOLED → "Direct connection" (used only by drizzle-kit migrate)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-name-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-name.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Encryption at Rest (AES-256-GCM) — required
# Generate: openssl rand -hex 32
# Must be a 64-character hex string.
# ------------------------------------------------------------------------------
SECRETS_MASTER_KEY=your_64_character_hex_master_key_here

# ------------------------------------------------------------------------------
# 3. Groq (required for the default LLM provider)
# Get from: https://console.groq.com/keys
# Key always starts with gsk_
# Models: openai/gpt-oss-20b  openai/gpt-oss-120b  qwen/qwen3.8-27b
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 4. OpenRouter (optional — server-side fallback key)
# Users can also provide their own key in the UI Settings panel.
# Key starts with sk-or-v1-
# ------------------------------------------------------------------------------
OPENROUTER_FALLBACK_KEY=sk-or-v1-your_optional_openrouter_fallback_key_here

# ------------------------------------------------------------------------------
# 5. Server and Network Configuration
# ------------------------------------------------------------------------------
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 6. OAuth (optional — required only if login buttons should work)
# Google: https://console.cloud.google.com → APIs → Credentials
# GitHub: https://github.com/settings/developers → OAuth Apps
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# ------------------------------------------------------------------------------
# 7. Neo4j Aura (optional — required for RAG document tools)
# Get from: https://console.neo4j.io → Databases → Connect
# Note: NEO4J_USER is the instance ID (e.g. "03352133"), NOT "neo4j".
# ------------------------------------------------------------------------------
NEO4J_URI=neo4j+s://your_instance_id.databases.neo4j.io
NEO4J_USER=your_instance_id
NEO4J_PASSWORD=your_neo4j_aura_password_here

# ------------------------------------------------------------------------------
# 8. External Tool APIs (optional)
# SerpAPI: https://serpapi.com/manage-api-key (used by search_products tool)
# ------------------------------------------------------------------------------
SERPAPI_KEY=your_serpapi_key_here

# ------------------------------------------------------------------------------
# 9. Code MCP — Repository Workspace
# Local filesystem path where public GitHub repos are cloned.
# Must be writable. Ephemeral on Render free tier (lost on restart).
# ------------------------------------------------------------------------------
KARMA_CODE_WORKSPACE_ROOT=./.karma-workspaces
KARMA_CODE_MAX_FILES=3000
KARMA_CODE_MAX_FILE_BYTES=204800
KARMA_CODE_WORKSPACE_TTL_MS=21600000

# ------------------------------------------------------------------------------
# 10. MCP Server (same port as API when run together)
# ------------------------------------------------------------------------------
MCP_PORT=3001
MCP_URL=http://localhost:3001/mcp

# ------------------------------------------------------------------------------
# 11. External AI App Builders (optional)
# Manus API: https://open.manus.ai/docs/v2/introduction
# ------------------------------------------------------------------------------
MANUS_API_KEY=
# MANUS_API_BASE_URL=https://api.manus.ai/v2
# REPLIT_AUTH_TOKEN=
# REPLIT_MCP_URL=https://mcp.replit.com/server/mcp
