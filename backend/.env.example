# ==============================================================================
# Karma Backend Environment Configuration
# Copy this file to backend/.env and customize with your own credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Postgres on Neon)
# Get connection strings from: Neon Console -> Project -> Dashboard -> Connect
# ------------------------------------------------------------------------------
# Pooled connection string (host contains '-pooler'), used by the running app:
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# Direct connection string (unpooled), used only by drizzle-kit migrations:
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Encryption at Rest (AES-256-GCM)
# Generate a 32-byte random key with the command:
#   openssl rand -hex 32
# ------------------------------------------------------------------------------
SECRETS_MASTER_KEY=your_64_character_hex_master_key_here

# ------------------------------------------------------------------------------
# 3. Model Provider (OpenRouter BYOK)
# Users can provide their own key in the UI. Optional server fallback key:
# ------------------------------------------------------------------------------
OPENROUTER_FALLBACK_KEY=sk-or-v1-optional_server_fallback_key_here

# ------------------------------------------------------------------------------
# 4. Server & Network Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 5. External Tool Providers (SerpAPI for Google Shopping)
# ------------------------------------------------------------------------------
SERPAPI_KEY=your_serpapi_key_here

# ------------------------------------------------------------------------------
# 6. Multi-MCP Server Configuration
# ------------------------------------------------------------------------------
MCP_PORT=3000
MCP_URL=http://localhost:3000/mcp
# ------------------------------------------------------------------------------
# 7. External AI App Builders (Manus & Replit)
# ------------------------------------------------------------------------------
# Manus API v2 credentials (https://open.manus.ai/docs/v2/introduction)
# Kept strictly server-side, never exposed to the frontend browser:
MANUS_API_KEY=
# Optional Manus base URL override (defaults to https://api.manus.ai/v2):
# MANUS_API_BASE_URL=https://api.manus.ai/v2

# Replit Configuration (https://docs.replit.com/references/mcp/overview)
# Optional Replit programmatic token / OAuth header for Replit remote MCP:
# REPLIT_AUTH_TOKEN=
# Optional Replit MCP endpoint (defaults to https://mcp.replit.com/server/mcp):
# REPLIT_MCP_URL=https://mcp.replit.com/server/mcp
