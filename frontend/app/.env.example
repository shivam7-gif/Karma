# Copy to .env for local overrides. Vite only exposes variables prefixed with VITE_.

# false = talk to the real backend (recommended). true = mock SSE stream, no API required.
VITE_USE_MOCK=false

# Chat endpoint. Use a relative path so the Vite proxy (dev) or same-origin API (prod) is used.
# For a separately hosted API, set an absolute URL, for example:
# VITE_API_ENDPOINT=https://your-api-host.example.com/api/chat
VITE_API_ENDPOINT=/api/chat

# Optional OAuth client IDs shown on the login page. Leave blank to hide/disable those buttons.
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
