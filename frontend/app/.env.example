# ==============================================================================
# Frontend Environment Variables (.env)
# ==============================================================================

# Set to 'false' if connecting to live backend API, or 'true' to use the built-in mock stream
VITE_USE_MOCK=true

# URL of the backend chat API (used when VITE_USE_MOCK=false)
# In production on Render: https://karma-api.onrender.com/api/chat
VITE_API_ENDPOINT=https://karma-api.onrender.com/api/chat

# OAuth Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
